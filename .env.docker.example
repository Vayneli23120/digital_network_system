# ============================================================
# Network Automation System — Docker 全栈部署环境变量
# 复制为 .env 后修改（.env 已被 .gitignore 忽略，切勿提交）
#   cp .env.docker.example .env
# ============================================================

# === 数据库 ===
DB_USER=nasuser
DB_PASSWORD=change_me_strong_db_password

# === Redis ===
REDIS_PASSWORD=change_me_redis

# === 认证 / 安全 ===
AUTH_ENABLED=true
APP_DEBUG=false
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production_use_a_long_random_string_min_32_chars
# 可选：凭证加密独立密钥（留空则回退由 JWT_SECRET 派生）
ENCRYPTION_KEY=

# === 初始管理员（首次启动自动创建，幂等）===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# === CORS（前端经 nginx 同源访问；此值供直连/调试）===
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === SNMP Trap 接收 ===
SNMP_TRAP_PORT=162
# 留空 = fail-closed（拒绝所有 Trap）；生产需与设备侧 community 一致
SNMP_TRAP_COMMUNITY=
