# Network Automation System - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 配置文件（包含敏感信息）
config.yaml
inventory/devices.yaml

# 数据库
data/*.db
data/*.db-journal
# SQLite WAL 模式的临时文件（database.py 对 SQLite 启用了 journal_mode=WAL）
data/*.db-shm
data/*.db-wal
*.db

# 备份文件（只忽略仓库根目录的 backups/，否则会连带忽略 app/features/backups/
# 这类源码目录 —— 该目录下的新文件曾必须用 git add -f 才能加入版本控制）
/backups/

# 日志
logs/*

# 设备照片
assets/devices/*

# 前端
frontend/node_modules/
frontend/dist/
frontend/.env

# 离线包目录
offline_packages/

# 文档归档
.docs-archive/

# 测试
.pytest_cache/
.coverage
htmlcov/
.tox/

# macOS
.DS_Store

# Windows
Thumbs.db
