# Frontend environment variables
# Copy to .env.local for local development

# Backend API base URL (for dev server proxy)
VITE_API_URL=http://localhost:8000

# WebSocket backend base URL (optional override; default is location.host)
# Used by Monitor3D (/ws/device-status) and Deploy (/ws/deploy/:sessionId).
# Set to ws://<backend-ip>:8000 when accessing frontend remotely or backend on a different host
# Example: VITE_WS_URL=ws://192.168.4.37:8000
#VITE_WS_URL=ws://localhost:8000

# API base URL for production builds (relative or absolute)
VITE_API_BASE_URL=/api
